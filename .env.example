# Identifiants Tractive (obligatoires)
TRACTIVE_EMAIL=ton.email@example.com
TRACTIVE_PASSWORD=ton_mot_de_passe

# Laisser vide pour utiliser le premier tracker du compte
TRACTIVE_TRACKER_ID=

# Intervalle de réactivation de la LED, en secondes.
# Doit être plus court que le délai d'extinction automatique de Tractive.
REFRESH_SECONDS=120

# Niveau de batterie (%) sous lequel la LED n'est plus rallumée
MIN_BATTERY=20

# Ne pas allumer la LED quand le chat est à la maison (zone d'économie d'énergie)
SKIP_WHEN_HOME=true

# Repli géographique, utilisé seulement si HOME_RADIUS_METERS > 0.
# Utile si la zone d'économie d'énergie ne remonte pas dans l'API.
HOME_LATITUDE=
HOME_LONGITUDE=
HOME_RADIUS_METERS=0

# Position utilisée pour calculer le crépuscule et l'aube
LOCATION_NAME=Veyrier
LOCATION_REGION=Switzerland
LOCATION_TIMEZONE=Europe/Zurich
LOCATION_LATITUDE=46.167
LOCATION_LONGITUDE=6.183

# DEBUG pour des logs détaillés
LOG_LEVEL=INFO

# --- Expériences batterie (entrypoint --experiment) ---------------------------
# Durée du bras testé, en heures. Garder la même valeur d'une nuit à l'autre,
# et la choisir pour que le bras soit terminé avant d'aller chercher le collier.
EXPERIMENT_HOURS=8

# Après le bras, la session continue d'observer sans rien envoyer, jusqu'à son
# arrêt manuel au ramassage du collier. Durée maximale de cette attente.
EXPERIMENT_TAIL_HOURS=6

# Niveau de batterie (%) sous lequel le bras s'arrête avant la fin : un collier
# vide n'envoie plus de rapport et la nuit serait perdue.
EXPERIMENT_MIN_BATTERY=15

# Espacement des lectures ou des commandes du bras testé, en secondes.
# Vide = REFRESH_SECONDS. Le fixer ici évite qu'un changement de REFRESH_SECONDS
# en production ne modifie la campagne de mesure en cours de route.
EXPERIMENT_INTERVAL_SECONDS=

# Espacement des relevés d'observation, identique dans tous les bras.
EXPERIMENT_SAMPLE_SECONDS=900

# Texte libre enregistré avec la session : emplacement, météo, température.
EXPERIMENT_NOTE=

# Dossier des fichiers de session (ignoré par git).
EXPERIMENT_DIR=data
