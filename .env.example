# Identifiants Tractive (obligatoires)
TRACTIVE_EMAIL=ton.email@example.com
TRACTIVE_PASSWORD=ton_mot_de_passe

# Laisser vide pour utiliser le premier tracker du compte
TRACTIVE_TRACKER_ID=

# Intervalle de réactivation de la LED, en secondes.
# Doit être plus court que le délai d'extinction automatique de Tractive.
REFRESH_SECONDS=120

# Niveau de batterie (%) sous lequel la LED n'est plus rallumée
MIN_BATTERY=20

# Position utilisée pour calculer le crépuscule et l'aube
LOCATION_NAME=Veyrier
LOCATION_REGION=Switzerland
LOCATION_TIMEZONE=Europe/Zurich
LOCATION_LATITUDE=46.167
LOCATION_LONGITUDE=6.183

# DEBUG pour des logs détaillés
LOG_LEVEL=INFO
