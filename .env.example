# Identifiants Tractive (obligatoires)
TRACTIVE_EMAIL=ton.email@example.com
TRACTIVE_PASSWORD=ton_mot_de_passe

# Laisser vide pour utiliser le premier tracker du compte
TRACTIVE_TRACKER_ID=

# --- Consommation de batterie -------------------------------------------------
# Intervalle de réactivation de la LED PENDANT qu'elle est allumée, en secondes.
# Doit rester sous le délai d'extinction automatique de Tractive, mais le plus
# près possible : chaque commande réveille le modem du tracker.
REFRESH_SECONDS=240

# Intervalle de vérification quand la LED N'EST PAS allumée (jour, chat à la
# maison, budget épuisé). Aucun appel à l'API n'est fait dans ces cas, donc une
# valeur élevée ne coûte rien et évite de solliciter le tracker.
IDLE_POLL_SECONDS=900

# Fenêtres pendant lesquelles la LED peut être allumée, séparées par des
# virgules. Chaque borne est une heure locale HH:MM, ou l'un des deux événements
# solaires « dusk » (crépuscule civil) et « dawn » (aube civile), qui suivent la
# saison. Vide = une seule fenêtre dusk-dawn, soit toute la nuit.
#
# Les fenêtres sont le levier principal : la LED mérite sa batterie pendant le
# trafic du soir et du petit matin, pas au milieu de la nuit.
LIGHT_WINDOWS=dusk-21:30,05:00-dawn

# Budget de minutes allumées PAR FENÊTRE, remis à zéro à chaque nouvelle
# fenêtre. 0 = illimité. Attention : le budget se dépense au DÉBUT de la
# fenêtre. Un budget trop serré sur « 04:00-dawn » éteindrait la LED avant
# l'aube, donc avant l'heure de pointe. Mieux vaut resserrer les fenêtres et
# garder ici un plafond large, qui ne sert que de garde-fou.
MAX_LED_MINUTES=240

# Niveau de batterie (%) sous lequel la LED n'est plus rallumée
MIN_BATTERY=30

# --- Filtre « à la maison » ---------------------------------------------------
# Ne pas allumer la LED quand le chat est dans la zone d'économie d'énergie
SKIP_WHEN_HOME=true

# Repli géographique, utilisé seulement si HOME_RADIUS_METERS > 0.
# Utile si la zone d'économie d'énergie ne remonte pas dans l'API.
HOME_LATITUDE=
HOME_LONGITUDE=
HOME_RADIUS_METERS=0

# --- Position (calcul du crépuscule et de l'aube) -----------------------------
LOCATION_NAME=Veyrier
LOCATION_REGION=Switzerland
LOCATION_TIMEZONE=Europe/Zurich
LOCATION_LATITUDE=46.167
LOCATION_LONGITUDE=6.183

# DEBUG pour des logs détaillés
LOG_LEVEL=INFO
